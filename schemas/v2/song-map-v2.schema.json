{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna.local/schemas/premium/song-map-v2.schema.json",
  "title": "DNA Premium SongMap 2.0",
  "type": "object",
  "x-contract-version": "2.0",
  "additionalProperties": false,
  "required": ["schema", "version", "source", "sourceSha256", "ppq", "endTick", "tempoMap", "meterMap", "bars", "beatGrid", "key", "chordCells", "sections", "phrases", "cadences", "roleSegments", "polyphony", "manualReview", "confidence", "analysisVelocityUsed", "correctionAudit", "analysis", "invariants", "mapHash"],
  "properties": {
    "schema": {"const": "dna-premium-song-map"},
    "version": {"const": "2.0"},
    "source": {"type": "object"},
    "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ppq": {"type": "integer", "minimum": 1},
    "endTick": {"type": "integer", "minimum": 1},
    "tempoMap": {"type": "array", "minItems": 1},
    "meterMap": {"type": "array", "minItems": 1},
    "bars": {"type": "array", "minItems": 1},
    "beatGrid": {"type": "array", "minItems": 1},
    "key": {"type": "object"},
    "chordCells": {"type": "array", "minItems": 2},
    "sections": {"type": "array", "minItems": 1},
    "phrases": {"type": "array", "minItems": 1},
    "cadences": {"type": "array"},
    "roleSegments": {"type": "array", "items": {"type": "object", "required": ["trackUid", "trackIndex", "trackNumber", "channelIndex", "channelNumber", "sectionId", "startTick", "endTick", "role", "confidence", "decision", "evidence"], "properties": {"trackUid": {"type": "string", "pattern": "^trk-[0-9a-f]{20}(?:-[1-9][0-9]*)?$"}}}},
    "polyphony": {"type": "object"},
    "manualReview": {"type": "array"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "analysisVelocityUsed": {"const": false},
    "correctionAudit": {"type": "array"},
    "analysis": {"type": "object"},
    "invariants": {"type": "object"},
    "mapHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}