{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna-midi-studio.local/schemas/v2/reliability-report-v1.schema.json",
  "title": "Zero Silent Failure Reliability Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "date", "result", "passed", "structuralCorpus", "sealedMutationFuzz", "atomicPublication", "workerParity", "batchIsolation", "pathSafety", "stressProfiles", "regressionVault", "summary", "release", "reportHash"],
  "properties": {
    "schema": {"const": "dna-zero-silent-failure-report"},
    "version": {"const": "1.0"},
    "date": {"type": "string", "format": "date"},
    "result": {"enum": ["pass", "fail"]},
    "passed": {"type": "boolean"},
    "structuralCorpus": {"type": "array", "minItems": 24},
    "sealedMutationFuzz": {"type": "array", "minItems": 1},
    "atomicPublication": {"type": "object"},
    "workerParity": {"type": "object"},
    "batchIsolation": {"type": "object"},
    "pathSafety": {"type": "object"},
    "stressProfiles": {"type": "array", "minItems": 1},
    "regressionVault": {"type": "object"},
    "summary": {"type": "object"},
    "release": {"type": "object"},
    "reportHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "x-contract-version": "1.0"
}