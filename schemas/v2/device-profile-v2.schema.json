{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna.local/schemas/premium/device-profile-v2.schema.json",
  "title": "DNA Premium DeviceProfile v2",
  "type": "object",
  "x-contract-version": "2.0",
  "additionalProperties": false,
  "required": ["schema", "version", "manufacturer", "model", "osVersion", "serialNumberHash", "status", "styleChannels", "markerContract", "soundBindings", "articulationMaps", "polyphony", "evidence", "activation", "profileHash"],
  "properties": {
    "schema": {"const": "dna-premium-device-profile"}, "version": {"const": "2.0"},
    "manufacturer": {"const": "Korg"}, "model": {"const": "Pa800"}, "osVersion": {"type": "string"},
    "serialNumberHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["WAITING_FOR_DEVICE", "DEVICE_TEST_FAILED", "PA800_DEVICE_CERTIFIED"]},
    "styleChannels": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": 9, "maximum": 16}},
    "markerContract": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "soundBindings": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object"}},
    "articulationMaps": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object"}},
    "polyphony": {"type": "object"}, "evidence": {"type": "object"},
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["deviceSpecificMapsAllowed", "voiceCostModelAllowed", "pa800CertifiedLabelAllowed", "finalCertifiedMidiExportAllowed"],
      "properties": {
        "deviceSpecificMapsAllowed": {"type": "boolean"}, "voiceCostModelAllowed": {"type": "boolean"},
        "pa800CertifiedLabelAllowed": {"type": "boolean"}, "finalCertifiedMidiExportAllowed": {"const": false}
      }
    },
    "profileHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}