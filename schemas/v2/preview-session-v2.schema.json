{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna-midi-studio.local/schemas/v2/preview-session-v2.schema.json",
  "title": "DNA Premium Preview Session 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "source", "validatorIdentity", "controls", "transport", "variants", "audioSeparation", "warnings", "audit", "readOnly", "midiMutationAllowed", "finalMidiGenerated", "validatorVerdictMutableByPreview", "pa800DeviceCertified", "previewSessionHash"],
  "properties": {
    "schema": {"const": "dna-premium-preview-session"},
    "version": {"const": "2.0"},
    "source": {"type": "object"},
    "validatorIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["passed", "finalMidiSha256", "reportHash", "scope", "identityHash"],
      "properties": {
        "passed": {"const": true},
        "finalMidiSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reportHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scope": {"enum": ["FINAL_MIDI", "STRUCTURAL_PREVIEW_ONLY"]},
        "identityHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "controls": {"type": "object"},
    "transport": {"type": "object"},
    "variants": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "required": ["variantId", "clockId", "notes", "polyphony", "loudness"],
        "properties": {"variantId": {"enum": ["A", "B", "C"]}}
      }
    },
    "audioSeparation": {"type": "object"},
    "warnings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "audit": {"type": "object"},
    "readOnly": {"const": true},
    "midiMutationAllowed": {"const": false},
    "finalMidiGenerated": {"const": false},
    "validatorVerdictMutableByPreview": {"const": false},
    "pa800DeviceCertified": {"const": false},
    "previewSessionHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "x-contract-version": "2.0",
  "x-preview-is-device-certification": false
}