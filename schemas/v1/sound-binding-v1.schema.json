{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna.local/schemas/premium/sound-binding-v1.schema.json",
  "title": "DNA Premium SoundBinding v1",
  "type": "object",
  "x-contract-version": "1.0",
  "additionalProperties": false,
  "required": ["schema", "version", "trackUid", "trackIndex", "trackNumber", "channelIndex", "channelNumber", "bankMsb", "bankLsb", "program", "role", "playableRange", "factoryProfileId", "status"],
  "properties": {
    "schema": {"const": "dna-premium-sound-binding"},
    "version": {"const": "1.0"},
    "trackUid": {"type": "string", "pattern": "^trk-[0-9a-f]{16}$"},
    "trackIndex": {"type": "integer", "minimum": 0, "maximum": 15},
    "trackNumber": {"type": "integer", "minimum": 1, "maximum": 16},
    "channelIndex": {"type": "integer", "minimum": 0, "maximum": 15},
    "channelNumber": {"type": "integer", "minimum": 1, "maximum": 16},
    "bankMsb": {"type": "integer", "minimum": 0, "maximum": 127},
    "bankLsb": {"type": "integer", "minimum": 0, "maximum": 127},
    "program": {"type": "integer", "minimum": 0, "maximum": 127},
    "role": {"type": "string", "minLength": 1},
    "playableRange": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "integer", "minimum": 0, "maximum": 127}, "maximum": {"type": "integer", "minimum": 0, "maximum": 127}}},
    "factoryProfileId": {"type": "string", "pattern": "^[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}$"},
    "articulationMapId": {"type": ["string", "null"]},
    "status": {"enum": ["EXACT", "UNRESOLVED", "SHARED_CHANNEL_CONFLICT"]}
  }
}
