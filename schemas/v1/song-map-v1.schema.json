{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna.local/schemas/premium/song-map-v1.schema.json",
  "title": "DNA Premium SongMap v1",
  "type": "object",
  "x-contract-version": "1.0",
  "additionalProperties": false,
  "required": ["schema", "version", "sourceSha256", "ppq", "tempoMap", "meterMap", "chordCells", "sections", "roleSegments", "analysisVelocityUsed", "confidence"],
  "properties": {
    "schema": {"const": "dna-premium-song-map"},
    "version": {"const": "1.0"},
    "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ppq": {"type": "integer", "minimum": 1},
    "tempoMap": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["tick", "bpm"], "properties": {"tick": {"type": "integer", "minimum": 0}, "bpm": {"type": "number", "exclusiveMinimum": 0}}}},
    "meterMap": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["tick", "numerator", "denominator"], "properties": {"tick": {"type": "integer", "minimum": 0}, "numerator": {"type": "integer", "minimum": 1}, "denominator": {"enum": [1, 2, 4, 8, 16, 32]}}}},
    "chordCells": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["startTick", "endTick", "symbol", "confidence"], "properties": {"startTick": {"type": "integer", "minimum": 0}, "endTick": {"type": "integer", "minimum": 1}, "symbol": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "sections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "startTick", "endTick", "confidence"], "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "startTick": {"type": "integer", "minimum": 0}, "endTick": {"type": "integer", "minimum": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "roleSegments": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["trackUid", "role", "startTick", "endTick", "confidence"], "properties": {"trackUid": {"type": "string", "pattern": "^trk-[0-9a-f]{16}$"}, "role": {"type": "string"}, "startTick": {"type": "integer", "minimum": 0}, "endTick": {"type": "integer", "minimum": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "analysisVelocityUsed": {"const": false},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
