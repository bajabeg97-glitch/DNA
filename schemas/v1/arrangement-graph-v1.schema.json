{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna.local/schemas/premium/arrangement-graph-v1.schema.json",
  "title": "DNA Premium ArrangementGraph v1",
  "type": "object",
  "x-contract-version": "1.0",
  "additionalProperties": false,
  "required": ["schema", "version", "nodes", "edges", "globalBudgets", "readOnly"],
  "properties": {
    "schema": {"const": "dna-premium-arrangement-graph"},
    "version": {"const": "1.0"},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["marker", "bars", "targetEnergy", "roles"], "properties": {"marker": {"enum": ["i1cv1", "i2cv1", "v1cv1", "v2cv1", "v3cv1", "v4cv1", "f1cv1", "f2cv1", "e1cv1", "e2cv1"]}, "bars": {"type": "integer", "minimum": 1, "maximum": 32}, "targetEnergy": {"type": "number", "minimum": 0, "maximum": 100}, "roles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}},
    "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "transitionType"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "transitionType": {"enum": ["direct", "fill", "break", "ending"]}, "obligations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}},
    "globalBudgets": {"type": "object", "additionalProperties": false, "required": ["maximumAddedNotes", "maximumTransformations", "maximumConcurrentMidiNotes"], "properties": {"maximumAddedNotes": {"type": "integer", "minimum": 0}, "maximumTransformations": {"type": "integer", "minimum": 0}, "maximumConcurrentMidiNotes": {"type": "integer", "minimum": 1}}},
    "readOnly": {"const": true}
  }
}
